<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/btnMorning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_orange_light"
            android:onClick="btnMorningClick"
            android:text="@string/button_morning"
            android:textColor="@android:color/black"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_orange_dark"
            android:onClick="btnDayClick"
            android:text="@string/button_day"
            android:textColor="@android:color/black"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEvening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_red_light"
            android:onClick="btnEveningClick"
            android:text="@string/button_evening"
            android:textColor="@android:color/black"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_dark"
            android:onClick="btnNightClick"
            android:text="@string/button_night"
            android:textColor="@android:color/black"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="470dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <ImageView
            android:id="@+id/imageNight"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:visibility="invisible"
            app:srcCompat="@drawable/night" />

        <ImageView
            android:id="@+id/imageEvening"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:visibility="invisible"
            app:srcCompat="@drawable/evening" />

        <ImageView
            android:id="@+id/imageDay"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:visibility="invisible"
            app:srcCompat="@drawable/day" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMorning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imageMorning"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/morning"
                tools:ignore="ImageContrastCheck" />

            <Button
                android:id="@+id/btnShip"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginEnd="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Корабль"
                android:onClick="onShipClick"
                app:layout_constraintBottom_toBottomOf="@+id/imageMorning"
                app:layout_constraintEnd_toEndOf="@+id/imageMorning"
                app:layout_constraintTop_toTopOf="@+id/imageMorning"
                app:layout_constraintVertical_bias="0.531" />

            <Button
                android:id="@+id/btnPirate"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:background="@android:color/transparent"
                android:contentDescription="Пират"
                android:onClick="onPirateClick"
                app:layout_constraintBottom_toBottomOf="@+id/imageMorning"
                app:layout_constraintEnd_toEndOf="@+id/imageMorning"
                app:layout_constraintHorizontal_bias="0.339"
                app:layout_constraintStart_toStartOf="@+id/imageMorning"
                app:layout_constraintTop_toTopOf="@+id/imageMorning"
                app:layout_constraintVertical_bias="0.645" />

            <Button
                android:id="@+id/btnMap"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="Карта"
                android:onClick="onMapClick"
                app:layout_constraintBottom_toBottomOf="@+id/imageMorning"
                app:layout_constraintStart_toStartOf="@+id/imageMorning"
                app:layout_constraintTop_toTopOf="@+id/imageMorning"
                app:layout_constraintVertical_bias="0.8" />

            <Button
                android:id="@+id/btnChest"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="Сундук"
                android:onClick="onChestClick"
                app:layout_constraintBottom_toBottomOf="@+id/imageMorning"
                app:layout_constraintEnd_toEndOf="@+id/imageMorning"
                app:layout_constraintTop_toTopOf="@+id/imageMorning"
                app:layout_constraintVertical_bias="0.8" />

            <Button
                android:id="@+id/btnParrot"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Попугай"
                android:onClick="onParrotClick"
                app:layout_constraintBottom_toBottomOf="@+id/imageMorning"
                app:layout_constraintStart_toStartOf="@+id/imageMorning"
                app:layout_constraintTop_toTopOf="@+id/imageMorning"
                app:layout_constraintVertical_bias="0.309" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>